{
  "name": "thorchain-wiki",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "node scripts/require-node22.mjs && next dev",
    "build": "node scripts/require-node22.mjs && node scripts/build-standalone.mjs",
    "start": "node scripts/require-node22.mjs && node scripts/start-standalone.mjs",
    "start:next": "node scripts/require-node22.mjs && next start",
    "start:standalone": "node scripts/require-node22.mjs && node scripts/start-standalone.mjs",
    "lint": "node scripts/require-node22.mjs && eslint",
    "typecheck": "node scripts/require-node22.mjs && tsc --noEmit",
    "pretest:unit": "node scripts/require-node22.mjs",
    "test:unit": "node scripts/require-node22.mjs && vitest run",
    "test:unit:watch": "node scripts/require-node22.mjs && vitest",
    "test:e2e": "node scripts/require-node22.mjs && playwright test",
    "test:e2e:docker-smoke": "node scripts/require-node22.mjs && playwright test tests/runtime.spec.ts tests/home.spec.ts tests/network.spec.ts tests/dynamic-fees.spec.ts tests/economics.spec.ts tests/stats.spec.ts --project=chromium -g \"@docker-smoke\"",
    "test:e2e:visual": "node scripts/require-node22.mjs && playwright test tests/visual-safety.spec.ts tests/deep-dives.spec.ts -g \"visually safe\"",
    "test:e2e:links": "node scripts/require-node22.mjs && playwright test tests/link-integrity.spec.ts --project=chromium",
    "test:e2e:csp": "node scripts/require-node22.mjs && CSP_ENFORCE=1 playwright test tests/runtime.spec.ts tests/routes.spec.ts -g \"security headers are present|normal page loads do not emit CSP reports\"",
    "check:release-tracked": "node scripts/require-node22.mjs && node scripts/check-release-tracked.mjs",
    "generate:search": "node scripts/require-node22.mjs && node scripts/generate-mdx-search.mjs",
    "generate:knowledge": "node scripts/require-node22.mjs && node scripts/generate-knowledge.mjs",
    "check:knowledge": "node scripts/require-node22.mjs && node scripts/generate-knowledge.mjs --check",
    "check:content": "node scripts/require-node22.mjs && node scripts/generate-mdx-search.mjs --check && node scripts/check-curated-data.mjs && node scripts/generate-knowledge.mjs --check",
    "check:live-snapshot": "node scripts/require-node22.mjs && node scripts/check-live-chain-snapshot.mjs",
    "check:production-readiness": "node scripts/require-node22.mjs && node scripts/check-production-readiness.mjs",
    "report:content-reviews": "node scripts/require-node22.mjs && node scripts/report-content-reviews.mjs",
    "report:source-drift": "node scripts/require-node22.mjs && node scripts/report-source-drift.mjs",
    "smoke:standalone": "node scripts/require-node22.mjs && node scripts/smoke-standalone.mjs",
    "smoke:docker": "node scripts/require-node22.mjs && node scripts/smoke-docker-runtime.mjs",
    "audit:prod": "node scripts/require-node22.mjs && npm audit --omit=dev --audit-level=moderate",
    "audit:all": "node scripts/require-node22.mjs && node scripts/audit-dependencies.mjs",
    "check:runtime-url": "node scripts/require-node22.mjs && node scripts/check-runtime-url.mjs",
    "dev:vinext": "VINEXT_BUILD=1 vite dev --port 3001",
    "build:vinext": "VINEXT_BUILD=1 vite build && next typegen",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "build:cloudflare": "npm run build:vinext && cp cloudflare/do-entry.mjs dist/server/do-entry.mjs && node scripts/cloudflare-artifact.mjs --write",
    "deploy:cloudflare": "wrangler deploy --config wrangler.do.jsonc",
    "test:e2e:cloudflare": "node scripts/require-node22.mjs && CSP_ENFORCE=1 PLAYWRIGHT_RUNTIME=cloudflare playwright test --project=chromium"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@next/mdx": "^16.3.8",
    "@tailwindcss/typography": "^0.5.20",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "lunr": "^2.3.9",
    "next": "^16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.61.0",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/lunr": "^2.3.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19.3.0",
    "@vinext/cloudflare": "^1.0.0-beta.11",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "jiti": "^2.7.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vinext": "^1.0.0-beta.13",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.142.0"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "fflate": "0.8.3",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.6"
    },
    "miniflare": {
      "sharp": "0.35.5"
    }
  },
  "type": "module"
}
